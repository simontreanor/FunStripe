<Project>

  <!--
    Single source of truth for version numbers, imported automatically by every
    project in the repository.

      FunStripeVersion  - the FunStripe.Core NuGet package version. Also stamped into
                          generated files via the code generator and used to derive the
                          v<major>/* release tags.
      StripeApiVersion  - the Stripe OpenAPI spec version the generated code targets;
                          must match a file in spec/ named stripe-openapi-<version>.json.

    Versioning strategy:
      - New Stripe API spec version  -> minor bump (e.g. 2.0.6 -> 2.1.0)
      - Generated model types change shape (generator fix) -> minor bump, with
        Upgrade notes in CHANGELOG.md (e.g. 3.1.2 -> 3.2.0)
      - Library bug fixes / features -> patch bump (e.g. 2.1.0 -> 2.1.1)
      - New Stripe release train, or a breaking change to the hand-written API
        (RestApi, Config, Util, JSON) -> major bump (e.g. 2.4.0 -> 3.0.0)

    The "Check for new Stripe OpenAPI spec" workflow bumps these automatically when it
    opens a spec-update PR; for a manual release, edit them here and nowhere else.
  -->
  <PropertyGroup>
    <FunStripeVersion>3.2.1</FunStripeVersion>
    <StripeApiVersion>2026-10-28.endive</StripeApiVersion>
  </PropertyGroup>

</Project>
